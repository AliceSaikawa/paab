{
	"name": "paab",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0",
		"npm": ">=11.12.1"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --config wrangler.local.jsonc",
		"typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && npm run test",
		"cf-typegen": "wrangler types",
		"cli:build": "esbuild scripts/paab.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.wrangler/tmp/paab-cli.mjs",
		"seed": "npm run -s cli:build && node .wrangler/tmp/paab-cli.mjs seed",
		"token": "npm run -s cli:build && node .wrangler/tmp/paab-cli.mjs token",
		"audit-log": "npm run -s cli:build && node .wrangler/tmp/paab-cli.mjs audit-log",
		"suspend": "npm run -s cli:build && node .wrangler/tmp/paab-cli.mjs suspend",
		"resume": "npm run -s cli:build && node .wrangler/tmp/paab-cli.mjs resume",
		"revoke-token": "npm run -s cli:build && node .wrangler/tmp/paab-cli.mjs revoke-token"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@cloudflare/vitest-plugin": "1.9.0",
		"@modelcontextprotocol/client": "2.4.0",
		"@types/node": "26.6.6",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "5.1.1",
		"wrangler": "4.166.0"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.4.0",
		"zod": "4.6.7"
	}
}
